    {
      "name": "5x5_2_goals",
      "game": {
        "size": 5,
        "n_landmarks": 2,
        "n_clues": 1,
        "n_questions": 1,
        "max_moves": 8,
        "history_len": 2
      },
      "warm_start_from_previous_stage": true
    }
  ]
