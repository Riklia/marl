{
  "name": "curriculum_4x4_to_5x5",
  "device": "cpu",
  "base": {
    "game": {
      "size": 4,
      "n_landmarks": 1,
      "n_clues": 1,
      "n_questions": 1,
      "max_moves": 6,
      "history_len": 2,
      "instant_reward_multiplier": 1.0,
      "end_reward_multiplier": 1.0
    },
    "training": {
      "training_epochs": 1,
      "n_episodes": 200,
      "batch_size": 32,
      "alpha": 0.0003,
      "gamma": 0.99,
      "gae_lambda": 0.95,
      "policy_clip": 0.2,
      "n_epochs": 4
